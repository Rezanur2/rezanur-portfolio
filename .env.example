# Public URL used for canonical links, Open Graph URLs, robots.txt, and sitemap.xml.
# Copy this file to .env.local and replace the value for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct email delivery for the contact form:
# Option A: Formspree (e.g. https://formspree.io/f/xxxxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Option B: Resend API Key (e.g. re_xxxxxxxxxxxx)
# If set, messages are delivered server-side directly to mdrezanurrahman2@gmail.com
RESEND_API_KEY=
